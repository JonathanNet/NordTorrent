<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NordTorrent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/lime</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorAccent">@color/lime</item>
        <item name="colorPrimary">@color/lime</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="Theme.NordTorrent.Player" parent="Theme.NordTorrent">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Text.Eyebrow" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/lime</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Display" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">52sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.04</item>
        <item name="android:lineSpacingMultiplier">0.92</item>
    </style>

    <style name="Text.H1" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="Text.H2" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/muted_strong</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Text.Muted" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Mono" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textColor">@color/muted_strong</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="Widget.Nord.Button" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">22dp</item>
        <item name="android:paddingRight">22dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Nord.Button.Primary" parent="Widget.Nord.Button">
        <item name="android:textColor">#10150D</item>
        <item name="android:background">@drawable/btn_primary</item>
    </style>

    <style name="Widget.Nord.Input" parent="@android:style/Widget.Material.EditText">
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Widget.Nord.NavButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">100dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/nav_item_bg</item>
        <item name="android:textColor">@color/nav_text_color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
