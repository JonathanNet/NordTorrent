<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:clipToOutline="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/media_art"
        android:layout_width="match_parent"
        android:layout_height="142dp">

        <TextView
            android:id="@+id/media_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha="0.3"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:textSize="62sp" />

        <ImageView
            android:id="@+id/media_kind_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="13dp"
            android:alpha="0.9"
            android:contentDescription="@null"
            android:src="@drawable/ic_film"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/media_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/pill_bg"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="@color/muted_strong"
            android:textSize="8sp" />

        <ImageView
            android:id="@+id/media_play"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:background="@drawable/pill_bg"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_play"
            android:tint="@color/text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="11dp"
        android:paddingEnd="13dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/media_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:minLines="1"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/media_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="9sp" />

        <ProgressBar
            android:id="@+id/media_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="9dp"
            android:max="100"
            android:progressBackgroundTint="#2A343B"
            android:progressTint="@color/lime" />
    </LinearLayout>
</LinearLayout>
