# Public address used for origin checks and links. Use the exact URL you open in a browser.
NORDTORRENT_PUBLIC_URL=http://192.168.1.101:8080

# Set to true only when the UI is served through HTTPS.
NORDTORRENT_COOKIE_SECURE=false

# Set to true when a reverse proxy sets X-Forwarded-For / X-Forwarded-Host.
NORDTORRENT_TRUST_PROXY=false

# How long a browser/Android session lasts.
NORDTORRENT_SESSION_HOURS=720

# Optional first-run administrator. Remove both after the first start.
# Leaving both blank opens the setup screen in the web UI instead.
NORDTORRENT_ADMIN_USER=
NORDTORRENT_ADMIN_PASSWORD=

# Host directory for users, sessions and DHT state.
# It is mounted into the container as /data; the container path must stay /data.
DATA_DIR=./data

# Host UID/GID that own DATA_DIR and the download directory.
PUID=1000
PGID=1000

# Host path that contains the media. It is mounted read-write as /downloads.
DOWNLOAD_DIR=./downloads

# Optional: name of the download folder selected by default. Leave blank to let
# NordTorrent choose automatically (prefers a mounted "complete" folder).
# NORDTORRENT_DEFAULT_DOWNLOAD_FOLDER=

# Optional: the public address and forwarded torrent port shown in the UI.
# Leave the IP blank to discover it automatically. If the router forwards a
# different external port (for example 50000 -> 42000), set it here.
# These can also be changed in Indstillinger -> Port & netværk; a saved
# /data/network.json takes precedence over these variables on restart.
# NORDTORRENT_EXTERNAL_IP=
# NORDTORRENT_EXTERNAL_PORT=
# NORDTORRENT_IP_LOOKUP_URL=https://api.ipify.org

WEB_PORT=8080
TZ=Europe/Copenhagen
RUST_LOG=nordtorrent=info,tower_http=warn,librqbit=warn
